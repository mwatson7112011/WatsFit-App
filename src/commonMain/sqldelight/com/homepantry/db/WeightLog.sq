-- WeightLog table for tracking weight over time
CREATE TABLE WeightLog (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    date      TEXT    NOT NULL UNIQUE,
    weightLbs REAL    NOT NULL,
    notes     TEXT,
    createdAt TEXT    NOT NULL
);

selectAll:
SELECT * FROM WeightLog ORDER BY date DESC;

selectRecent:
SELECT * FROM WeightLog ORDER BY date DESC LIMIT ?;

selectByDateRange:
SELECT * FROM WeightLog WHERE date >= ? AND date <= ? ORDER BY date ASC;

selectLatest:
SELECT * FROM WeightLog ORDER BY date DESC LIMIT 1;

selectFirst:
SELECT * FROM WeightLog ORDER BY date ASC LIMIT 1;

insert:
INSERT OR REPLACE INTO WeightLog (date, weightLbs, notes, createdAt)
VALUES (?, ?, ?, ?);

deleteById:
DELETE FROM WeightLog WHERE id = ?;

countAll:
SELECT COUNT(*) FROM WeightLog;
