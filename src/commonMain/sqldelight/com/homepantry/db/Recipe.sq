-- Recipe table for Mediterranean & Thai recipes
CREATE TABLE Recipe (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    title        TEXT    NOT NULL,
    description  TEXT    NOT NULL DEFAULT '',
    category     TEXT    NOT NULL,
    cuisine      TEXT    NOT NULL DEFAULT 'mediterranean',
    texture      TEXT    NOT NULL DEFAULT 'tender',
    tags         TEXT    NOT NULL DEFAULT '[]',
    ingredients  TEXT    NOT NULL,
    instructions TEXT    NOT NULL,
    prepTimeMin  INTEGER,
    cookTimeMin  INTEGER,
    servings     INTEGER NOT NULL DEFAULT 2,
    nutrition    TEXT,
    isUserAdded  INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM Recipe ORDER BY title ASC;

selectById:
SELECT * FROM Recipe WHERE id = ?;

selectByCategory:
SELECT * FROM Recipe WHERE category = ? ORDER BY title ASC;

selectByCuisine:
SELECT * FROM Recipe WHERE cuisine = ? ORDER BY title ASC;

selectByTexture:
SELECT * FROM Recipe WHERE texture IN ? ORDER BY title ASC;

searchByTitle:
SELECT * FROM Recipe WHERE title LIKE '%' || ? || '%' ORDER BY title ASC;

selectFiltered:
SELECT * FROM Recipe WHERE texture != 'crunchy' ORDER BY title ASC;

insert:
INSERT INTO Recipe (title, description, category, cuisine, texture, tags, ingredients, instructions, prepTimeMin, cookTimeMin, servings, nutrition, isUserAdded)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM Recipe WHERE id = ?;

countAll:
SELECT COUNT(*) FROM Recipe;

countByCuisine:
SELECT cuisine, COUNT(*) AS count FROM Recipe GROUP BY cuisine;
